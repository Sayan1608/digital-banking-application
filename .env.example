# ── Project ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=dbank

# ── MySQL ─────────────────────────────────────────────────
MYSQL_VERSION=8.0.40
MYSQL_ROOT_PASSWORD=REPLACE_ME
MYSQL_DATABASE=dbank_core
MYSQL_USER=dbank
MYSQL_PASSWORD=REPLACE_ME
MYSQL_PORT=3307

# ── Redis ─────────────────────────────────────────────────
REDIS_VERSION=7.4-alpine
REDIS_PASSWORD=REPLACE_ME
REDIS_PORT=6379

# ── Kafka / Zookeeper ─────────────────────────────────────
CONFLUENT_VERSION=7.7.1
ZOOKEEPER_CLIENT_PORT=2181
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_JMX_PORT=9101

# ── Kafka UI ──────────────────────────────────────────────
KAFKA_UI_PORT=8080
